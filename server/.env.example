# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Leave it blank to use the six built-in demo accounts and keep passphrases in memory.
# Where to find the values: Supabase dashboard, Project Settings, API Keys (the secret key). See database/README.md.

# Sign-in (server/db/user-store.js)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional, older name for the same kind of key. Family passphrases (server/passphrases.js), risk cases,
# reports and freezes (server/records.js) use SUPABASE_SECRET_KEY above, or this one if that is blank.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the secret that signs sign-in cookies (server/auth.js). Blank = worked out from
# SUPABASE_SECRET_KEY, so every copy of the server (Vercel runs many) agrees without extra setup.
SESSION_SECRET=

# AI helper chat (server/chat.js + server/ai.js). Three ways; Gemini is used first if its key is set.
#   Google Gemini (free key, works on Vercel): get a key at aistudio.google.com (Get API key), put it in
#   GEMINI_API_KEY. Never commit the key; on Vercel add it under Environment Variables.
GEMINI_API_KEY=
# Optional: which Gemini model. Blank = gemini-3.5-flash-lite.
GEMINI_MODEL=
#   Ollama Cloud (works on Vercel, needs usage credit): put your key from ollama.com in OLLAMA_API_KEY, and a cloud model
#   in OLLAMA_MODEL (e.g. gpt-oss:20b). Never commit the key; on Vercel add both under Environment Variables.
#   On this laptop (free, no limits, not on Vercel): install Ollama, run  ollama pull gemma3:4b ,
#   put gemma3:4b in OLLAMA_MODEL and leave OLLAMA_API_KEY blank.
# No Gemini key and OLLAMA_MODEL blank: the chat answers with its scripted demo replies instead.
OLLAMA_MODEL=
OLLAMA_API_KEY=
# Optional: where Ollama is. Blank = https://ollama.com with a key, http://localhost:11434 without.
OLLAMA_URL=
# Optional: how long to wait for the AI (milliseconds) before using the demo reply. Blank = 25000.
AI_TIMEOUT_MS=
