# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Leave it blank to use the six built-in demo accounts and keep passphrases in memory.
# Where to find the values: Supabase dashboard, Project Settings, API Keys (the secret key). See database/README.md.

# Sign-in (server/db/user-store.js)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional, older name for the same kind of key. Family passphrases (server/passphrases.js), risk cases,
# reports and freezes (server/records.js) use SUPABASE_SECRET_KEY above, or this one if that is blank.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the secret that signs sign-in cookies (server/auth.js). Blank = worked out from
# SUPABASE_SECRET_KEY, so every copy of the server (Vercel runs many) agrees without extra setup.
SESSION_SECRET=
